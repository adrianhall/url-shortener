{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "rootDir": ".",
    "tsBuildInfoFile": ".build/tsconfig.tooling.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": [
    "access.config.ts",
    "cloudflare.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "src/client/cloudflare.config.ts",
    "src/worker/path-policies.ts"
  ]
}
