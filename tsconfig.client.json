{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/client/**/*.ts", "tests/client/**/*.ts"],
  "exclude": ["src/client/cloudflare.config.ts"]
}
