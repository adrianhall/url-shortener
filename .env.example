# A custom hostname in the cfapps.uk Cloudflare zone.
APP_HOSTNAME="link.<your-domain>"

# Reserved for the Phase 2 Access policies protecting /admin and /api/*.
ACCESS_ALLOWED_EMAIL_DOMAIN="<your-domain>"

# Required by the Access reconciliation commands.
CLOUDFLARE_ACCOUNT_ID="<your-account-id>"

# Optional in CI. For local use, `cf auth login` is preferred.
# CLOUDFLARE_API_TOKEN=replace-with-api-token
