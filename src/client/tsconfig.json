{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "../../.build/tsconfig.client.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "../../tests/client/**/*.ts"],
  "exclude": ["cloudflare.config.ts"]
}
